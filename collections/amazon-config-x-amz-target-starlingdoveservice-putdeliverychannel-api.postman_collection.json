              "raw": "{\n  \"DeliveryChannel\": {\n    \"name\": \"<string>\",\n    \"s3BucketName\": \"<string>\",\n    \"s3KeyPrefix\": \"<string>\",\n    \"s3KmsKeyArn\": \"<string>\",\n    \"snsTopicARN\": \"<string>\",\n    \"configSnapshotDeliveryProperties\": {\n      \"deliveryFrequency\": \"<string>\"\n    }\n  }\n}",
